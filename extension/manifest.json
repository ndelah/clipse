{
  "manifest_version": 3,
  "name": "Clipse",
  "version": "0.8.3",
  "description": "Summarize YouTube videos with key takeaways, timestamps, and searchable local history. Bring your own OpenAI API key.",
  "minimum_chrome_version": "116",
  "permissions": [
    "alarms",
    "offscreen",
    "sidePanel",
    "storage",
    "tabs",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://youtube.com/*",
    "https://m.youtube.com/*",
    "https://api.openai.com/*",
    "https://api.typesafe.ai/*"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Clipse \u2014 summary history",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://youtube.com/*",
        "https://m.youtube.com/*"
      ],
      "js": [
        "page-context.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://youtube.com/*",
        "https://m.youtube.com/*"
      ],
      "js": [
        "content-script.js",
        "player-button.js",
        "thumbnail-button.js"
      ],
      "run_at": "document_start",
      "css": [
        "player-button.css",
        "thumbnail-button.css"
      ]
    }
  ],
  "options_page": "options.html",
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "assets/eclipse.svg"
      ],
      "matches": [
        "https://www.youtube.com/*",
        "https://youtube.com/*",
        "https://m.youtube.com/*"
      ]
    }
  ]
}
